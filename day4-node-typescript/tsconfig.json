{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",                          /* Compile to modern JavaScript */
    
    /* Modules */
    "module": "commonjs",                        /* Use CommonJS for Node.js */
    "rootDir": "./src",                          /* Source files are in src/ folder */
    "outDir": "./dist",                          /* Compiled files go to dist/ folder */
    "moduleResolution": "node",                  /* Use Node.js module resolution */
    "esModuleInterop": true,                     /* Better compatibility with ES modules */
    
    /* Type Checking */
    "strict": true,                              /* Enable all strict type-checking options */
    "skipLibCheck": true,                        /* Skip type checking of declaration files */
    
    /* Emit */
    "sourceMap": true,                           /* Generate .map files for debugging */
    "removeComments": true,                      /* Remove comments in output files */
    
    /* Interop Constraints */
    "forceConsistentCasingInFileNames": true     /* Ensure consistent file name casing */
  },
  "include": ["src/**/*"],                       /* Include all files in src/ */
  "exclude": ["node_modules", "dist"]            /* Exclude these folders */
}
